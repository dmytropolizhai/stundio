# Cloudflare Pages response headers for the landing project (a separate project from the app).
# Matching rules ADD to each other, so Cache-Control is set per path and never on the catch-all.
# Hashed files (JS, fonts) never change and cache for a year; HTML must revalidate so a deploy
# shows up at once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: no-cache
/ru/
  Cache-Control: no-cache
/en/
  Cache-Control: no-cache
/ua/
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=86400
/qr.svg
  Cache-Control: public, max-age=3600
