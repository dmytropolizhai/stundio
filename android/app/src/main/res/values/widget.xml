<?xml version="1.0" encoding="utf-8"?>
<!--
  Light-mode widget palette, approximated from the Studio design system (src/ds/tokens/).
  RemoteViews cannot read CSS variables, so these are hand-mirrored: keep them in step with
  colors.css / dark.css when those are regenerated.
-->
<resources>
    <!-- surface-card / text-strong / text-muted -->
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_text_strong">#0B0C10</color>
    <color name="widget_text_muted">#5B6070</color>
    <!-- blue-500, "Studio Electric" — the fallback rail when a subject has no colour. -->
    <color name="widget_accent">#1E3AFF</color>
    <!-- The countdown widget's progress-bar track (the unfilled portion). -->
    <color name="widget_track">#E4E7EF</color>

    <string name="widget_name">Nākamā stunda</string>
    <string name="widget_description">Kas notiek tagad un kas ir nākamā.</string>
    <!-- Shown before JS has ever published, and once a cached payload's own boundary has
         passed without a fresh sync (WidgetScheduler / WidgetFreshness#isFresh) — either way
         there is nothing cached left that is still true to show. -->
    <string name="widget_empty_title">Atver Stundio</string>
    <!-- "Atjaunināts pirms %s" — %s is one of the three durations below, already formatted. -->
    <string name="widget_updated_prefix">Atjaunināts pirms %s</string>
    <string name="widget_updated_minutes">%d min</string>
    <string name="widget_updated_hours">%d h</string>
    <string name="widget_updated_days">%d d</string>

    <string name="countdown_widget_name">Laiks līdz beigām</string>
    <string name="countdown_widget_description">Liels atskaites laiks līdz stundas beigām vai sākumam.</string>

    <string name="all_day_widget_name">Šodiena</string>
    <string name="all_day_widget_description">Visas šodienas stundas vienā sarakstā.</string>
    <!-- Shown when the payload is fresh but every lesson today has already ended. -->
    <string name="widget_all_day_done">Šodien stundu vairs nav</string>
</resources>
