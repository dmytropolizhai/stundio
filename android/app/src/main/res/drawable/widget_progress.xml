<?xml version="1.0" encoding="utf-8"?>
<!--
  The countdown widget's progress bar. RemoteViews cannot tint a stock ProgressBar per subject
  colour at API 23 (`setProgressTintList` needs API 31), so the fill is a fixed accent — only
  the fraction filled (`RemoteViews#setProgressBar`) is dynamic.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_accent" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
