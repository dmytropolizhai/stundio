{
  "app-id": "io.github.dmytropolizhai.stundio",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node24",
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "stundio",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/node24/bin:/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/stundio/cargo",
      "CARGO_NET_OFFLINE": "true",
      "npm_config_cache": "/run/build/stundio/flatpak-node/npm-cache"
    }
  },
  "modules": [
    {
      "name": "stundio",
      "buildsystem": "simple",
      "build-commands": [
        "npm ci --offline --no-audit --no-fund",
        "npm run build",
        "cargo build --manifest-path src-tauri/Cargo.toml --release --offline --locked --features custom-protocol",
        "install -Dm755 src-tauri/target/release/stundio /app/bin/stundio",
        "install -Dm644 packaging/flatpak/io.github.dmytropolizhai.stundio.desktop /app/share/applications/${FLATPAK_ID}.desktop",
        "install -Dm644 packaging/flatpak/io.github.dmytropolizhai.stundio.metainfo.xml /app/share/metainfo/${FLATPAK_ID}.metainfo.xml",
        "install -Dm644 src-tauri/icons/icon.png /app/share/icons/hicolor/512x512/apps/${FLATPAK_ID}.png",
        "install -Dm644 LICENSE /app/share/licenses/${FLATPAK_ID}/LICENSE"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".desktop-tools",
            ".flatpak-builder",
            "build-flatpak",
            "flatpak-repo",
            "node_modules",
            "dist",
            "src-tauri/target"
          ]
        },
        "generated/node-sources.json",
        "generated/cargo-sources.json"
      ]
    }
  ]
}
